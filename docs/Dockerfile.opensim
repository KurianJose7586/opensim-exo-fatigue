# One image for every stage: OpenSim Moco (Phase A/C, D1, D4) + PyTorch and
# stable-baselines3 (D2, D3). The repo is NOT baked in -- mount it at /work, so
# code changes never need a rebuild.
#
# Build:  docker build -f docs/Dockerfile.opensim -t opensim-exo:4.6 .
# Test:   docker run --rm -v "$PWD":/work opensim-exo:4.6 bash run_pipeline.sh check
# GPU:    add --gpus all; torch picks the GPU up for D2/D3, everything else is CPU.
#
# NOT YET BUILT: written and checked against a working Windows install of the same
# packages (OpenSim 4.6, Python 3.11), but the Linux image itself has not been built.
# The `check` stage below is the first thing to run -- it fails in minutes if anything is off.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget ca-certificates git libgl1 libglu1-mesa libxi6 libxrender1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Miniforge: conda-forge by default, no Anaconda channel licence question
ENV CONDA_DIR=/opt/conda
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /tmp/mf.sh \
    && bash /tmp/mf.sh -b -p $CONDA_DIR && rm /tmp/mf.sh
ENV PATH=$CONDA_DIR/bin:$PATH

# OpenBLAS, not MKL: on Windows MKL's Intel runtime overwrote the one OpenSim
# bundles and broke IPOPT (WinError 182). Pinned here too so Linux matches.
# Python 3.11: the newest the opensim 4.6 conda build supports.
RUN conda create -y -n opensim -c opensim-org -c conda-forge \
        python=3.11 opensim=4.6 "libblas=*=*openblas" numpy scipy pandas pyyaml matplotlib \
    && conda clean -afy
ENV PATH=$CONDA_DIR/envs/opensim/bin:$PATH

# Same env gets the learning stack. Default torch wheel = CUDA build on Linux.
RUN python -m pip install --no-cache-dir torch gymnasium stable-baselines3 casadi

# NOT casadi from conda: Moco bundles its own CasADi, and a second conda copy
# in the same env made Moco fail ('get_forward' not defined). The pip wheel
# keeps its DLLs inside site-packages, which is what src/mpc needs.
# Never import opensim and casadi in ONE process: opensim loads Moco's libcasadi
# first and the pip casadi then fails (undefined symbol). No script does that --
# src/mpc uses casadi without opensim, the twin uses opensim without casadi.

# Fail the build, not the job, if anything is missing. Separate processes, see above.
RUN python -c "import opensim, torch, stable_baselines3; print('OpenSim', opensim.GetVersion(), 'torch', torch.__version__)" \
 && python -c "import casadi; print('casadi', casadi.__version__)"

ENV OPENSIM_MOCO_PARALLEL=1 PYTHONUNBUFFERED=1
WORKDIR /work
CMD ["/bin/bash"]
